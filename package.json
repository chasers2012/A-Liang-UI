{
    "name": "quant-agent",
    "private": true,
    "pnpm": {
        "ignoredBuiltDependencies": [
            "sharp",
            "unrs-resolver"
        ]
    },
    "scripts": {
        "dev": "pnpm run dev:all",
        "dev:web": "pnpm --filter web dev",
        "dev:api": "uv run uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
        "sync:py": "uv sync",
        "install:all": "pnpm install && uv sync",
        "dev:all": "concurrently -n api,web -c cyan,magenta \"pnpm run dev:api\" \"pnpm run dev:web\"",
        "build": "pnpm --filter web build",
        "build:all": "pnpm --filter web build && pnpm run build:api",
        "build:api": "python apps/api/build.py",
        "lint": "pnpm --filter web lint",
        "prepare": "husky"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.5.0",
        "@commitlint/config-conventional": "^20.5.0",
        "concurrently": "^9.1.2",
        "husky": "^9.1.7"
    },
    "packageManager": "pnpm@9.15.0"
}
