# 在运行 uvicorn 的进程中生效（可 export 或配合 direnv）
# 完整说明见仓库根目录 .env.example

# QUANT_AGENT_WORKSPACE=
# 因子库落盘：{workspace}/config/factors.json 与 {workspace}/factors/<id>.py

CORS_ORIGINS=*
# 启动时将 app/evaluation/profile/examples/*.json 同步到 workspace；
# true: 覆盖已有同名 profile，false: 仅缺失时写入（默认）
EVALUATION_PROFILE_SEED_OVERWRITE=false

# 启动时将内置 evaluation metrics（evaluation_workflow_nodes 下 EvaluationMetric 子类）同步到 workspace；
# true: 覆盖已有同 id metric，false: 仅缺失时写入（默认）
EVALUATION_METRIC_SEED_OVERWRITE=false
