# 在运行 uvicorn 的进程中生效（可 export 或配合 direnv）
# 完整说明见仓库根目录 .env.example

# A_LIANG_UI_WORKSPACE=
# 因子库落盘：{workspace}/config/factors.json 与 {workspace}/factors/<id>.py

CORS_ORIGINS=*
# 启动时将 app/evaluation/profile/examples/*.json 同步到 workspace；
# true: 覆盖已有同名 profile，false: 仅缺失时写入（默认）
OVERWRITE_EXAMPLES=false
# 启动时将各模块注册的 skills 同步到 agent store；
# true: 总是覆盖已有同名 skill，false: 仅缺失时写入（默认）
OVERWRITE_SKILLS=false

# 调度器设置
SCHEDULER_CRON_DISPATCHER_ENABLED=true
SCHEDULER_CRON_POLL_SECONDS=30
SCHEDULER_EMBEDDED_WORKER_ENABLED=true
SCHEDULER_WORKER_POLL_SECONDS=1
