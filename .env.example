# quant-agent 环境变量示例

# --- Docker Compose（见 docker-compose.yml）---
# QUANT_AGENT_IMAGE=quant-agent:latest
# Docker 默认同源 /api；本地 pnpm dev 常用 http://127.0.0.1:8000/api
# NEXT_PUBLIC_QUANT_AGENT_API=/api
# 用法：
#   - 前端：复制下方「Next.js」段落到 apps/web/.env.local
#   - API：在运行 uvicorn 的终端中 export 这些变量，或使用 direnv / 系统环境变量
# 勿提交含密钥的 .env / .env.local（已在 .gitignore 中忽略）

# --- Next.js（apps/web）---
# 数据源页等调用的 FastAPI 基址（勿以 / 结尾）
NEXT_PUBLIC_QUANT_AGENT_API=http://127.0.0.1:8000/api

# 前端 FEATURE_FLAGS：逗号分隔功能 flag（见 apps/web/src/lib/feature-flags.ts）
# 示例：enable_profiles
# FEATURE_FLAGS=enable_profiles

# --- FastAPI（apps/api）与 workspace 库 ---
# 数据目录根路径；留空则默认为用户主目录下的 .quant-agent
# QUANT_AGENT_WORKSPACE=

# 允许跨域的来源，逗号分隔（须与前端实际访问来源一致；默认含 3000/3001）
CORS_ORIGINS=*

# 启动时将 app/evaluation/profile/examples/*.json 同步到 workspace；
# true: 覆盖已有同名 profile，false: 仅缺失时写入（默认）
OVERWRITE_EXAMPLES=false

